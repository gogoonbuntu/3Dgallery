rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Exhibition artwork images: authenticated users can upload, anyone can read
    match /exhibitions/{exhibitionCode}/artworks/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024  // 20MB limit
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
