rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // superAdmins: 로그인한 사용자만 개별 문서 읽기 가능, 쓰기는 불가 (콘솔에서 관리)
    match /superAdmins/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // exhibitions 및 하위 컬렉션
    match /exhibitions/{exhibitionCode} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
